#!/bin/sh /etc/rc.common
# OpenWrt procd service for the hy2tun client.
#
# Normal installation is through the hy2tun .ipk from the release:
#   opkg install ./hy2tun_<version>_<arch>.ipk
# The package installs this script but does not create a configuration or
# enable the service. Configure /etc/hy2tun/client.yaml, then enable and
# start the service from LuCI or with /etc/init.d/hy2tun.
#
# The client rewrites /etc/hy2tun/client.yaml on startup, assigned-port
# write-back, server push, and web edits. Do not watch that file with procd,
# or every write would restart the tunnel. After an external edit, run:
#   service hy2tun restart

START=95
STOP=10
USE_PROCD=1

start_service() {
	if [ ! -f /etc/hy2tun/client.yaml ]; then
		echo "hy2tun: /etc/hy2tun/client.yaml is missing" >&2
		return 1
	fi

	procd_open_instance
	procd_set_param command /usr/bin/hy2tun -c /etc/hy2tun/client.yaml
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
