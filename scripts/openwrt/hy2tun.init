#!/bin/sh /etc/rc.common
# OpenWrt procd service for the hy2tun client.
#
# Install from the extracted Linux archive root:
#   opkg update && opkg install ca-bundle
#   cp hy2tun /usr/bin/hy2tun
#   chmod +x /usr/bin/hy2tun
#   install -d -m 0755 /etc/hy2tun
#   cp examples/client.yaml /etc/hy2tun/client.yaml
#   chmod 600 /etc/hy2tun/client.yaml
#   cp scripts/openwrt/hy2tun.init /etc/init.d/hy2tun
#   chmod +x /etc/init.d/hy2tun
#   /etc/init.d/hy2tun enable
#   /etc/init.d/hy2tun start
#
# The client rewrites /etc/hy2tun/client.yaml on startup, assigned-port
# write-back, server push, and web edits. Do not watch that file with procd,
# or every write would restart the tunnel. After an external edit, run:
#   service hy2tun restart

START=95
STOP=10
USE_PROCD=1

start_service() {
	if [ ! -f /etc/hy2tun/client.yaml ]; then
		echo "hy2tun: /etc/hy2tun/client.yaml is missing" >&2
		return 1
	fi

	procd_open_instance
	procd_set_param command /usr/bin/hy2tun -c /etc/hy2tun/client.yaml
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
